# Fidelis calls an LLM through any OpenAI-compatible API. Copy this file to .env.local.
#
# Default: Google Gemini's free tier. Get a key at https://aistudio.google.com/apikey
LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.1-flash-lite

# How many LLM calls run in parallel. 1 suits free tiers (a few requests per minute); raise it for paid keys.
# LLM_CONCURRENCY=1

# Where the JSON store lives (default ./.data, or /tmp/fidelis on Vercel)
# DATA_DIR=.data
